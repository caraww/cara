{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cara-payment",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // مقدارهای عادی (تومان). رمزها (ZIBAL_MERCHANT و ADMIN_TOKEN) این‌جا نیستن؛ با  npx wrangler secret put  ذخیره می‌شن
  "vars": {
    "BASE_URL": "https://caraw.ir",
    "PRICE_PER_BEAD": "1500",
    "BASE_FEE": "150000",
    "ZIBAL_BASE": "https://relay.caraw.ir/zibal-relay.php?x=",
    "TEST_MODE": "0",
    "GAME_GOAL": "12",
  },

  // بدون id: Wrangler موقع دیپلوی خودش KV رو می‌سازه و وصل می‌کنه (سفارش‌ها این‌جا ذخیره می‌شن)
  "kv_namespaces": [{ "binding": "ORDERS" }],

  // محافظ بازی: هر توکن مرحله فقط یک بار قابل استفاده‌ست (جلوی امتحان رایگان همه‌ی خونه‌ها)
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "GameDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameDO"] }],

  // فقط /api/* به Worker می‌رسه؛ بقیه‌ی سایت مثل قبل از GitHub Pages می‌آد
  "routes": [
    { "pattern": "caraw.ir/api/*", "zone_name": "caraw.ir" },
    { "pattern": "www.caraw.ir/api/*", "zone_name": "caraw.ir" },
  ],
}
