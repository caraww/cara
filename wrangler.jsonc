{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cara-payment",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // مقدارهای عادی (تومان). رمزها (ZIBAL_MERCHANT و ADMIN_TOKEN) این‌جا نیستن؛ با  npx wrangler secret put  ذخیره می‌شن
  "vars": {
    "BASE_URL": "https://caraw.ir",
    "PRICE_PER_BEAD": "1500",
    "BASE_FEE": "150000",
    "ZIBAL_BASE": "https://relay.caraw.ir/relay.php",
    "TEST_MODE": "0", // حتماً ۰؛ با ۱ محصول تست ۵٬۰۰۰ تومانی برای همه قابل سفارشه
    "GAME_GOAL": "12",
    "GAME_GOAL2": "20",
    "GAME_DAILY_CAP": "30",
    "TELEGRAM_BOT_USERNAME": "Carawwbot",
  },

  // مقادیر فقط برای Preview؛ از درگاه و callback واقعی استفاده نمی‌شود.
  "previews": {
    "vars": {
      "BASE_URL": "https://preview.invalid",
      "PRICE_PER_BEAD": "1500",
      "BASE_FEE": "150000",
      "ZIBAL_BASE": "https://preview.invalid/relay.php",
      "TEST_MODE": "1",
      "GAME_GOAL": "12",
      "CALLBACK_URL": "https://preview.invalid/api/payment-callback",
      "RELAY_PAY_URL": "https://preview.invalid/pay.php",
      "TELEGRAM_BOT_USERNAME": "Carawwbot",
    },
  },

  // سفارش‌ها و داده‌های بازی همچنان در KV موجود ذخیره می‌شوند.
  "kv_namespaces": [{ "binding": "ORDERS" }],

  // دیتابیس Production حساب‌های کاربری؛ migrationها قبلاً با موفقیت اعمال شده‌اند.
  "d1_databases": [
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "cara-accounts-production",
      "database_id": "5121003c-2f0c-4016-a551-11743945dd08",
      "migrations_dir": "migrations",
    },
  ],

  // محافظ بازی: هر توکن مرحله فقط یک بار قابل استفاده‌ست (جلوی امتحان رایگان همه‌ی خونه‌ها)
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "GameDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameDO"] }],

  // فقط /api/* به Worker می‌رسه؛ بقیه‌ی سایت مثل قبل از GitHub Pages می‌آد
  "routes": [
    { "pattern": "caraw.ir/api/*", "zone_name": "caraw.ir" },
    { "pattern": "www.caraw.ir/api/*", "zone_name": "caraw.ir" },
  ],
}
