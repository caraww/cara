diff --git a/css/challenge.css b/css/challenge.css
new file mode 100644
index 0000000..a92f8d6
--- /dev/null
+++ b/css/challenge.css
@@ -0,0 +1,44 @@
+/* challenge.css — صفحه‌ی چالش هفتگی. کلاس‌ها همه با chl- شروع می‌شن. */
+.chl { box-sizing: border-box; max-width: 1040px; margin: 0 auto; padding: calc(var(--nh-h, 72px) + 24px) clamp(16px, 3vw, 36px) 72px; color: var(--cara-text, #242431); }
+.chl-hero { padding: clamp(22px, 4vw, 40px); border-radius: var(--cara-radius-lg, 26px); color: #f7f6fb; text-align: center;
+  background: radial-gradient(ellipse 30rem 18rem at 50% 0, rgba(155, 143, 193, .22), transparent 70%), linear-gradient(118deg, #17192e, #22243b 60%, #191b31); }
+.chl-eyebrow { display: inline-block; margin: 0 0 12px; padding: 6px 14px; border: 1px solid rgba(207, 174, 108, .42); border-radius: 999px; background: rgba(207, 174, 108, .09); color: #f3e2b4; font-size: 13px; font-weight: 700; }
+.chl-hero h1 { margin: 0; font-size: clamp(26px, 4.4vw, 44px); font-weight: 900; line-height: 1.4; text-wrap: balance; }
+.chl-theme { margin: 10px auto 0; max-width: 34em; color: rgba(235, 233, 243, .8); font-size: 17px; line-height: 2; }
+.chl-timer { display: inline-block; margin: 16px 0 0; padding: 8px 18px; border-radius: 999px; background: rgba(207, 174, 108, .16); color: #f3e2b4; font-size: 15px; font-weight: 800; }
+.chl-msg { margin: 18px 0; color: var(--cara-muted, #626273); font-size: 15px; text-align: center; }
+.chl-msg.is-error { color: #a8321f; }
+.chl h2 { margin: 40px 0 8px; font-size: 22px; font-weight: 900; }
+.chl-card, .chl-panel { box-sizing: border-box; background: #fff; border: 1px solid var(--cara-line, #d4d4df); border-radius: var(--cara-radius-lg, 26px); box-shadow: var(--cara-shadow-soft, 0 8px 24px rgba(36, 36, 49, .055)); }
+.chl-panel { margin-top: 20px; padding: clamp(18px, 3vw, 28px); }
+.chl-panel p { margin: 0 0 12px; line-height: 2; }
+.chl-rules { white-space: pre-line; }
+.chl-swatches { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 14px; }
+.chl-swatches i { display: block; width: 34px; height: 24px; border-radius: 8px; border: 1px solid rgba(0, 0, 0, .12); box-shadow: inset 0 2px rgba(255, 255, 255, .45), inset 0 -3px 5px rgba(0, 0, 0, .2); }
+.chl-prize { margin: 0; padding: 10px 14px; border-radius: 14px; background: var(--cara-accent-soft, #eeeef5); color: var(--cara-accent, #343b64); font-weight: 700; }
+.chl-form { display: grid; gap: 12px; max-width: 520px; }
+.chl-form label { display: grid; gap: 6px; font-size: 14px; font-weight: 700; }
+.chl-form input { min-height: 46px; padding: 0 14px; border: 1px solid var(--cara-line, #d4d4df); border-radius: 12px; font: inherit; font-weight: 400; background: #fff; }
+.chl-form input:focus-visible { outline: 3px solid var(--cara-detail, #9b8fc1); outline-offset: 2px; }
+.chl-preview { display: block; max-width: 100%; max-height: 260px; width: auto; height: auto; margin: 4px 0 8px; border-radius: 12px; background: #ece9f2; }
+.chl-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 22px; border: 1px solid var(--cara-accent, #343b64); border-radius: 999px; background: #fff; color: var(--cara-accent, #343b64); font: inherit; font-size: 15px; font-weight: 800; text-decoration: none; cursor: pointer; }
+.chl-btn:hover { background: var(--cara-accent-soft, #eeeef5); }
+.chl-btn--primary { background: var(--cara-accent, #343b64); color: #fff; }
+.chl-btn--primary:hover { background: #292f54; }
+.chl-btn:disabled { opacity: .55; cursor: not-allowed; }
+.chl-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
+.chl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; margin-top: 14px; }
+.chl-card { padding: 14px; display: flex; flex-direction: column; gap: 8px; scroll-margin-top: calc(var(--nh-h, 72px) + 16px); }
+.chl-card.is-target { outline: 3px solid var(--cara-detail, #9b8fc1); }
+.chl-card canvas { display: block; width: 100%; height: 240px; object-fit: contain; border-radius: 12px; background: #ece9f2; }
+.chl-card h3 { margin: 0; font-size: 16px; font-weight: 800; line-height: 1.6; }
+.chl-by { margin: 0; color: var(--cara-muted, #626273); font-size: 13px; }
+.chl-badge { align-self: flex-start; padding: 2px 12px; border-radius: 999px; background: #f3e2b4; color: #5b4310; font-size: 12px; font-weight: 800; }
+.chl-badge.is-mine { background: var(--cara-accent-soft, #eeeef5); color: var(--cara-accent, #343b64); }
+.chl-row { display: flex; gap: 8px; margin-top: auto; }
+.chl-row .chl-btn { flex: 1; min-height: 40px; padding: 0 10px; font-size: 14px; }
+.chl-vote[aria-pressed="true"] { background: var(--cara-accent, #343b64); color: #fff; }
+.chl-how { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 10px; }
+.chl-how li { counter-increment: s; position: relative; padding-inline-start: 42px; line-height: 2; }
+.chl-how li::before { content: counter(s, persian); position: absolute; inset-inline-start: 0; top: 4px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--cara-accent-soft, #eeeef5); color: var(--cara-accent, #343b64); font-weight: 900; line-height: 1; }
+@media (max-width: 560px) { .chl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .chl-card { padding: 10px; } .chl-card canvas { height: 190px; } .chl-actions .chl-btn { flex: 1 1 100%; } }
