{
  "name": "cara",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:beads": "node tools/build-beads.js",
    "build:works": "node -e \"process.env.CARA_REQUIRE_SHARP='1'; require('./tools/build-works.js')\"",
    "build:pages": "node tools/build-pages.js",
    "build": "npm run build:beads && npm run build:works && npm run build:pages",
    "check:palette": "node tools/sync-valid.js index.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.5": true,
    "onnxruntime-node@1.17.3": true
  },
  "overrides": {
    "@imgly/background-removal-node": {
      "sharp": "$sharp"
    }
  }
}
